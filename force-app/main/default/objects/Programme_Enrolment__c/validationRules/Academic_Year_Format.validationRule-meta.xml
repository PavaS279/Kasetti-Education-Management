<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Academic_Year_Format</fullName>
    <active>true</active>
    <errorConditionFormula
  >OR(NOT(REGEX(Academic_Year__c, &quot;^[0-9]{4}-[0-9]{2}$&quot;)), VALUE(RIGHT(Academic_Year__c, 2)) &lt;&gt; MOD(VALUE(LEFT(Academic_Year__c, 4)) + 1, 100))</errorConditionFormula>
    <errorMessage
  >Academic year must be YYYY-YY with consecutive years, for example 2026-27.</errorMessage>
</ValidationRule>
