<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closure_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(OR(ISPICKVAL(Status__c, &quot;Discontinued&quot;), ISPICKVAL(Status__c, &quot;Cancelled&quot;)), ISBLANK(Status_Reason__c))</errorConditionFormula>
    <errorMessage
  >Enter a reason when cancelling or discontinuing a programme enrolment.</errorMessage>
</ValidationRule>
