<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Attendance_Threshold_Range</fullName>
    <active>true</active>
    <description>Attendance threshold must be between 0% and 100%.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(Attendance_Threshold__c)), OR(Attendance_Threshold__c &lt; 0, Attendance_Threshold__c &gt; 1))</errorConditionFormula>
    <errorDisplayField>Attendance_Threshold__c</errorDisplayField>
    <errorMessage
  >Attendance threshold must be between 0% and 100%.</errorMessage>
</ValidationRule>
