<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Academic_Year_Format</fullName>
    <active>true</active>
    <description
  >Enter the academic year as YYYY-YY, for example 2026-27.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(Academic_Year__c)), IF(REGEX(Academic_Year__c, '[0-9]{4}-[0-9]{2}'), VALUE(RIGHT(Academic_Year__c, 2)) &lt;&gt; MOD(VALUE(LEFT(Academic_Year__c, 4)) + 1, 100), TRUE))</errorConditionFormula>
    <errorDisplayField>Academic_Year__c</errorDisplayField>
    <errorMessage
  >Enter the academic year as YYYY-YY, for example 2026-27.</errorMessage>
</ValidationRule>
