<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Effective_Range_Valid</fullName>
    <active>true</active>
    <description>Effective To must be on or after Effective From.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(Effective_To__c)), Effective_To__c &lt; Effective_From__c)</errorConditionFormula>
    <errorDisplayField>Effective_To__c</errorDisplayField>
    <errorMessage
  >Effective To must be on or after Effective From.</errorMessage>
</ValidationRule>
