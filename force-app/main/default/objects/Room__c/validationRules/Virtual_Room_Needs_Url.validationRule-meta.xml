<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Virtual_Room_Needs_Url</fullName>
    <active>true</active>
    <description>Virtual rooms need a meeting URL.</description>
    <errorConditionFormula
  >AND(ISPICKVAL(Room_Type__c, 'Virtual'), ISBLANK(Meeting_Url__c))</errorConditionFormula>
    <errorDisplayField>Meeting_Url__c</errorDisplayField>
    <errorMessage>Virtual rooms need a meeting URL.</errorMessage>
</ValidationRule>
