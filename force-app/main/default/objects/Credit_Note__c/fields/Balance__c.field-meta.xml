<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Balance__c</fullName>
    <label>Balance</label>
    <formula
  >IF(ISPICKVAL(Status__c, 'Void'), 0, BLANKVALUE(Amount__c, 0) - BLANKVALUE(Amount_Applied__c, 0) - BLANKVALUE(Amount_Refunded__c, 0))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>18</precision>
    <scale>2</scale>
    <type>Currency</type>
</CustomField>
