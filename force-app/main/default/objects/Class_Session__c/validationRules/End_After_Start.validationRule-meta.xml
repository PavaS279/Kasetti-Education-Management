<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_After_Start</fullName>
    <active>true</active>
    <description>End must be after Start.</description>
    <errorConditionFormula>End__c &lt;= Start__c</errorConditionFormula>
    <errorDisplayField>End__c</errorDisplayField>
    <errorMessage>End must be after Start.</errorMessage>
</ValidationRule>
