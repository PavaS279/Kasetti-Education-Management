<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reason_For_Cancellation</fullName>
    <active>true</active>
    <description>Enter a reason when cancelling a session.</description>
    <errorConditionFormula
  >AND(ISPICKVAL(Status__c, 'Cancelled'), ISBLANK(Cancellation_Reason__c))</errorConditionFormula>
    <errorDisplayField>Cancellation_Reason__c</errorDisplayField>
    <errorMessage>Enter a reason when cancelling a session.</errorMessage>
</ValidationRule>
