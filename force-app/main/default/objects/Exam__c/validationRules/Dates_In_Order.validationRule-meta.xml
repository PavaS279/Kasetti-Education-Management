<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Dates_In_Order</fullName>
    <active>true</active>
    <description>The end date cannot be before the start date.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(End_Date__c)), NOT(ISBLANK(Start_Date__c)), End_Date__c &lt; Start_Date__c)</errorConditionFormula>
    <errorDisplayField>End_Date__c</errorDisplayField>
    <errorMessage>The end date cannot be before the start date.</errorMessage>
</ValidationRule>
