<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Invoice_Anchor_Valid</fullName>
    <active>true</active>
    <errorConditionFormula
  >OR(AND(ISBLANK(Enrolment__c), ISBLANK(Programme_Enrolment__c)), AND(NOT(ISBLANK(Enrolment__c)), NOT(ISBLANK(Programme_Enrolment__c))))</errorConditionFormula>
    <errorMessage
  >An invoice must belong to either a section enrolment or a programme enrolment, not both.</errorMessage>
</ValidationRule>
