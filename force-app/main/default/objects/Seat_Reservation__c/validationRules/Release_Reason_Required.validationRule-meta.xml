<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName
  >Release_Reason_Required</fullName><active>true</active><errorConditionFormula
  >AND(ISPICKVAL(Status__c, &quot;Released&quot;), ISBLANK(Release_Reason__c))</errorConditionFormula><errorMessage
