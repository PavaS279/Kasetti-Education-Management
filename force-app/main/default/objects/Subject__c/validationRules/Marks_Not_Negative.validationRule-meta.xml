<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Marks_Not_Negative</fullName>
    <active>true</active>
    <description>Maximum marks cannot be negative.</description>
    <errorConditionFormula
  >OR(BLANKVALUE(Internal_Max__c, 0) &lt; 0, BLANKVALUE(Exam_Max__c, 0) &lt; 0)</errorConditionFormula>
    <errorMessage>Maximum marks cannot be negative.</errorMessage>
</ValidationRule>
