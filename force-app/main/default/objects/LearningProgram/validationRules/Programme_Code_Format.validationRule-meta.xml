<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Programme_Code_Format</fullName>
    <active>true</active>
    <description>Programme code must be one uppercase letter.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(Programme_Code__c)), NOT(REGEX(Programme_Code__c, '^[A-Z]$')))</errorConditionFormula>
    <errorDisplayField>Programme_Code__c</errorDisplayField>
    <errorMessage>Programme code must be one uppercase letter.</errorMessage>
</ValidationRule>
