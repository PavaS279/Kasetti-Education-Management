<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Programme_Duration_Positive</fullName>
    <active>true</active>
    <description>Programme duration must be greater than zero.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(Duration_Years__c)), Duration_Years__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Duration_Years__c</errorDisplayField>
    <errorMessage>Programme duration must be greater than zero.</errorMessage>
</ValidationRule>
