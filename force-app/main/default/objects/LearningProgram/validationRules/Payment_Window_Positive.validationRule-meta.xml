<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Window_Positive</fullName>
    <active>true</active>
    <description>Payment window must be greater than zero days.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(Payment_Window_Days__c)), Payment_Window_Days__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Payment_Window_Days__c</errorDisplayField>
    <errorMessage>Payment window must be greater than zero days.</errorMessage>
</ValidationRule>
