<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completion_Year_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula
  >Completion_Year__c &gt; YEAR(TODAY())</errorConditionFormula>
    <errorMessage>Completion year cannot be in the future.</errorMessage>
</ValidationRule>
