<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Percentage_In_Range</fullName>
    <active>true</active>
    <errorConditionFormula
  >OR(Min_Percentage__c &lt; 0, Min_Percentage__c &gt; 100)</errorConditionFormula>
    <errorMessage>Minimum percentage must be between 0 and 100.</errorMessage>
</ValidationRule>
