<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rank_Or_Score_Required</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(ISBLANK(Rank__c), ISBLANK(Score__c))</errorConditionFormula>
    <errorMessage>Enter a rank or score.</errorMessage>
</ValidationRule>
