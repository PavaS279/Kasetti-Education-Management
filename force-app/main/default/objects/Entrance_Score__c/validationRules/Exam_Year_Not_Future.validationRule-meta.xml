<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Exam_Year_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula
  >Exam_Year__c &gt; YEAR(TODAY())</errorConditionFormula>
    <errorMessage>Exam year cannot be in the future.</errorMessage>
</ValidationRule>
