<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Exam_Year_Range</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(NOT(ISBLANK(Exam_Year_From__c)),NOT(ISBLANK(Exam_Year_To__c)),Exam_Year_From__c&gt;Exam_Year_To__c)</errorConditionFormula>
    <errorMessage>Exam year from cannot be after exam year to.</errorMessage>
</ValidationRule>
