<apex:page
  controller="KemDocumentController"
  renderAs="pdf"
  applyHtmlTag="false"
  applyBodyTag="false"
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
>
  <html>
    <head>
      <style type="text/css">
        @page {
          size: A4;
          margin: 18mm 16mm 20mm 16mm;
          @bottom-center {
            content: "Page " counter(page) " of " counter(pages);
            font-family: sans-serif;
            font-size: 8pt;
            color: #8a94a3;
          }
        }
        body {
          font-family:
            Arial Unicode MS,
            sans-serif;
          font-size: 10pt;
          color: #16243a;
        }
        .band {
          background-color: #1b3a6b;
          color: #ffffff;
          padding: 14px 18px;
        }
        .band-table {
          width: 100%;
        }
        .brand {
          font-size: 18pt;
          font-weight: bold;
        }
        .brand-sub {
          font-size: 9pt;
          color: #c9d8f2;
        }
        .doc-title {
          font-size: 16pt;
          font-weight: bold;
          text-align: right;
          letter-spacing: 1px;
        }
        .doc-number {
          font-size: 10pt;
          text-align: right;
          color: #c9d8f2;
        }
        .section {
          margin-top: 18px;
        }
        .label {
          font-size: 8pt;
          color: #5f6b7a;
          text-transform: uppercase;
          letter-spacing: 0.5px;
        }
        .value {
          font-size: 10.5pt;
          font-weight: bold;
        }
        .muted {
          color: #5f6b7a;
          font-size: 9pt;
        }
        .grid {
          width: 100%;
          border-collapse: collapse;
        }
        .grid td {
          vertical-align: top;
          padding: 0 10px 0 0;
        }
        table.lines {
          width: 100%;
          border-collapse: collapse;
          margin-top: 8px;
        }
        table.lines th {
          background-color: #e8f0fd;
          color: #1b3a6b;
          font-size: 8pt;
          text-transform: uppercase;
          text-align: left;
          padding: 7px 8px;
        }
        table.lines td {
          padding: 7px 8px;
          border-bottom: 1px solid #e3e8ef;
        }
        .num {
          text-align: right;
        }
        .totals {
          width: 45%;
          margin-left: 55%;
          border-collapse: collapse;
          margin-top: 10px;
        }
        .totals td {
          padding: 5px 8px;
        }
        .totals .grand td {
          border-top: 2px solid #1b3a6b;
          font-size: 12pt;
          font-weight: bold;
        }
        .stamp {
          display: inline-block;
          padding: 4px 10px;
          border: 2px solid #2e844a;
          color: #2e844a;
          font-weight: bold;
          font-size: 11pt;
          letter-spacing: 1px;
        }
        .stamp-due {
          border-color: #c77700;
          color: #c77700;
        }
        .note {
          margin-top: 20px;
          padding: 10px 12px;
          background-color: #f4f7fb;
          border-left: 3px solid #2e6fd8;
          font-size: 9pt;
        }
        .footer {
          margin-top: 30px;
          font-size: 8pt;
          color: #8a94a3;
          border-top: 1px solid #e3e8ef;
          padding-top: 8px;
        }
        .signature {
          margin-top: 40px;
        }
        .signature-line {
          width: 200px;
          border-top: 1px solid #16243a;
          padding-top: 4px;
          font-size: 9pt;
        }
      </style>
    </head>
    <body>
      <c:KEM_Document_Header
        institution="{!institutionName}"
        branchName="{!branchName}"
        branchAddress="{!branchAddress}"
        branchContact="{!branchContact}"
        title="OFFER OF ADMISSION"
        number="{!application.Name}"
      />

      <div class="section">
        <table class="grid">
          <tr>
            <td>
              <div class="label">To</div>
              <div class="value">{!application.Account.Name}</div>
              <div class="muted">
                {!application.Account.PersonMailingStreet}
                {!application.Account.PersonMailingCity}
              </div>
            </td>
            <td style="text-align: right">
              <div class="label">Date</div>
              <div class="value">
                <apex:outputText value="{0, date, dd MMM yyyy}"
                  ><apex:param value="{!today}"
                /></apex:outputText>
              </div>
            </td>
          </tr>
        </table>
      </div>

      <div class="section">
        <p>Dear {!application.Account.Name},</p>
        <p>
          We are delighted to offer you a place on
          <b>{!application.Learning_Course__r.Name}</b>
          <apex:outputText
            rendered="{!NOT(ISBLANK(application.Requested_Offering__c))}"
            value=" in the class {!application.Requested_Offering__r.Name}"
          />
          at {!institutionName}<apex:outputText
            rendered="{!NOT(ISBLANK(branchName))}"
            value=", {!branchName}"
          />.
        </p>
        <p>
          This offer is valid until
          <b
            ><apex:outputText value="{0, date, dd MMM yyyy}"
              ><apex:param
                value="{!application.Offer_Expiry_Date__c}" /></apex:outputText></b
          >. To accept, please confirm with our admissions team before that
          date; your seat is then reserved and enrolment is completed.
        </p>
      </div>

      <apex:outputPanel
        layout="block"
        styleClass="section"
        rendered="{!fees.size > 0}"
      >
        <div class="label">Indicative fees</div>
        <table class="lines">
          <thead>
            <tr>
              <th>Fee</th>
              <th>Billing</th>
              <th class="num">Amount</th>
              <th class="num">Discount</th>
              <th class="num">Tax</th>
              <th class="num">Total ({!currencyCode})</th>
            </tr>
          </thead>
          <tbody>
            <apex:repeat value="{!fees}" var="f">
              <tr>
                <td>{!f.label}</td>
                <td>{!f.frequency}</td>
                <td class="num">
                  <apex:outputText value="{0, number, ###,###,##0.00}"
                    ><apex:param value="{!f.amount}"
                  /></apex:outputText>
                </td>
                <td class="num">
                  <apex:outputText value="{0, number, ###,###,##0.00}"
                    ><apex:param value="{!f.discount}"
                  /></apex:outputText>
                </td>
                <td class="num">
                  <apex:outputText value="{0, number, ###,###,##0.00}"
                    ><apex:param value="{!f.tax}"
                  /></apex:outputText>
                </td>
                <td class="num">
                  <apex:outputText value="{0, number, ###,###,##0.00}"
                    ><apex:param value="{!f.total}"
                  /></apex:outputText>
                </td>
              </tr>
            </apex:repeat>
          </tbody>
        </table>
        <table class="totals">
          <tr class="grand">
            <td>Total</td>
            <td class="num">
              {!currencyCode}
              <apex:outputText value="{0, number, ###,###,##0.00}"
                ><apex:param value="{!feeTotal}"
              /></apex:outputText>
            </td>
          </tr>
        </table>
        <div class="muted">
          Fees are confirmed at enrolment; discounts you qualify for are applied
          then.
        </div>
      </apex:outputPanel>

      <div class="note">
        Please keep this letter for your records. If you have any questions,
        contact the branch using the details above.
      </div>

      <div class="signature">
        <div class="signature-line">Admissions Office, {!institutionName}</div>
      </div>

      <div class="footer">
        This letter was generated electronically and is valid without a
        signature.
      </div>
    </body>
  </html>
</apex:page>
