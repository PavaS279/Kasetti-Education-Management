<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>College Results Published</label>
    <protected>false</protected>
    <values>
        <field>Active__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Body__c</field>
        <value xsi:type="xsd:string">Dear {{RecipientFirstName}},

The term {{Term}} results of {{StudentName}} ({{RollNumber}}) are published.

Outcome: {{Outcome}} · {{Percentage}}% · backlogs: {{Backlogs}}

Subject-wise marks are in the portal.

{{BranchName}}</value>
    </values>
    <values>
        <field>Description__c</field>
        <value
      xsi:type="xsd:string"
    >Sent when the Dean cancels a provisional college admission.</value>
    </values>
    <values>
        <field>Send_Email__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Send_Portal__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Subject__c</field>
        <value
      xsi:type="xsd:string"
    >Term {{Term}} results published - {{RollNumber}}</value>
    </values>
</CustomMetadata>
