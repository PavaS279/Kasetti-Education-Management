<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Refund Paid</label>
    <protected>false</protected>
    <values>
        <field>Active__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Body__c</field>
        <value xsi:type="xsd:string">Dear {{RecipientFirstName}},

We have sent a refund of {{Amount}} by {{Method}} (reference {{Reference}}) against credit note {{CreditNoteNumber}} for {{LearnerName}}.

Depending on your bank it may take a few days to appear.

{{BranchName}}</value>
    </values>
    <values>
        <field>Description__c</field>
        <value
      xsi:type="xsd:string"
    >Sent when a refund is paid out. Tokens: {{Amount}}, {{Method}}, {{Reference}}, {{CreditNoteNumber}}.</value>
    </values>
    <values>
        <field>Send_Email__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Send_Portal__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Subject__c</field>
        <value
      xsi:type="xsd:string"
    >Your refund of {{Amount}} has been sent</value>
    </values>
</CustomMetadata>
