@IsTest
private class DocumentServiceTest {
  private class Fixture {
    Branch__c branch;
    LearningCourse course;
    Account learner;
    Id enrolmentId;
  }

  private static Fixture fixture() {
    TestDataFactory.createReferenceData();
    Fixture f = new Fixture();
    f.branch = TestDataFactory.buildBranch();
    f.branch.Street__c = '12 MG Road';
    f.branch.City__c = 'Bengaluru';
    f.branch.Phone__c = '+91 80 1234 5678';
    insert f.branch;
    f.course = TestDataFactory.createCourse('Biology');
    insert new Fee_Price__c(
      Learning_Course__c = f.course.Id,
      Fee_Type__c = 'Tuition',
      Billing_Frequency__c = 'Term',
      Amount__c = 2000,
      Effective_From__c = Date.today().addDays(-1)
    );
    f.learner = PersonAccountService.buildPerson(
      'Doc',
      'Learner' + Crypto.getRandomInteger(),
      null,
      null,
      f.branch.Id,
      'Learner'
    );
    insert f.learner;
    EnrolmentService.EnrolmentRequest request = new EnrolmentService.EnrolmentRequest();
    request.learnerAccountId = f.learner.Id;
    request.offeringId = TestDataFactory.createOffering(
        f.course.Id,
        f.branch.Id,
        5
      )
      .Id;
    f.enrolmentId = EnrolmentService.enrol(request).enrolmentId;
    return f;
  }

  private static IndividualApplication offeredApplication(Fixture f) {
    Account learner = [
      SELECT Id, PersonContactId
      FROM Account
      WHERE Id = :f.learner.Id
    ];
    IndividualApplication application = new IndividualApplication(
      Category = 'Education',
      AccountId = learner.Id,
      ContactId = learner.PersonContactId,
      Status = 'Processing',
      Branch__c = f.branch.Id,
      Learning_Course__c = f.course.Id
    );
    insert application;
    return application;
  }

  @IsTest
  static void issuedInvoiceGetsItsPdfOnce() {
    System.runAs(TestDataFactory.admin()) {
      Fixture f = fixture();
      Test.startTest();
      Id invoiceId = BillingService.createInvoice(f.enrolmentId, true);
      Test.stopTest();
      Id documentId = DocumentService.existing(
        invoiceId,
        DocumentService.INVOICE
      );
      Assert.isNotNull(documentId, 'Generated by the queued job');
      Assert.areEqual(
        documentId,
        DocumentController.generateDocument(invoiceId),
        'Never regenerated'
      );
      List<DocumentService.DocumentInfo> docs = DocumentController.getDocuments(
        invoiceId
      );
      Assert.areEqual(1, docs.size(), 'One document filed');
      Assert.areEqual('Invoice', docs[0].kind, 'Kind');
      Assert.isTrue(docs[0].title.startsWith('Invoice TST-'), docs[0].title);
    }
  }

  @IsTest
  static void receiptOnlyForConfirmedPayments() {
    System.runAs(TestDataFactory.admin()) {
      Fixture f = fixture();
      DocumentService.suppressJobs = true;
      Id invoiceId = BillingService.createInvoice(f.enrolmentId, true);
      BillingService.PaymentRequest request = new BillingService.PaymentRequest();
      request.invoiceId = invoiceId;
      request.amount = 100;
      request.method = 'Cheque';
      request.confirmed = false;
      Id paymentId = BillingService.recordPayment(request).paymentId;
      try {
        DocumentController.generateDocument(paymentId);
        Assert.fail('Pending payments have no receipt');
      } catch (AuraHandledException e) {
        Assert.isTrue(e.getMessage().contains('confirmed'), e.getMessage());
      }
      BillingService.confirmPayment(paymentId);
      Id receipt = DocumentController.generateDocument(paymentId);
      Assert.areEqual(
        'Receipt',
        DocumentService.documentsFor(paymentId)[0].kind,
        'Receipt filed'
      );
      Assert.areEqual(
        receipt,
        DocumentService.generate(paymentId, DocumentService.RECEIPT),
        'Reused'
      );
    }
  }

  @IsTest
  static void offerLetterNeedsAnOffer() {
    System.runAs(TestDataFactory.admin()) {
      Fixture f = fixture();
      IndividualApplication application = offeredApplication(f);
      try {
        DocumentService.generate(application.Id, DocumentService.OFFER_LETTER);
        Assert.fail('No offer yet');
      } catch (AppException e) {
        Assert.isTrue(e.getMessage().contains('offer is made'), e.getMessage());
      }
      Database.update(
        new IndividualApplication(
          Id = application.Id,
          Offer_Status__c = 'Offered',
          Offer_Expiry_Date__c = Date.today().addDays(14)
        ),
        AccessLevel.SYSTEM_MODE
      );
      Id letter = DocumentService.generate(
        application.Id,
        DocumentService.OFFER_LETTER
      );
      Assert.isNotNull(letter, 'Offer letter filed');
      Assert.areEqual(
        DocumentService.OFFER_LETTER,
        DocumentService.kindFor(application.Id),
        'Kind from record type'
      );
    }
  }

  @IsTest
  static void templatesLoadTheirData() {
    System.runAs(TestDataFactory.admin()) {
      Fixture f = fixture();
      DocumentService.suppressJobs = true;
      Id invoiceId = BillingService.createInvoice(f.enrolmentId, true);
      BillingService.PaymentRequest request = new BillingService.PaymentRequest();
      request.invoiceId = invoiceId;
      request.amount = 500;
      request.method = 'UPI';
      Id paymentId = BillingService.recordPayment(request).paymentId;
      IndividualApplication application = offeredApplication(f);

      Test.setCurrentPage(Page.KEM_Invoice_Pdf);
      ApexPages.currentPage().getParameters().put('id', invoiceId);
      KemDocumentController invoiceDoc = new KemDocumentController();
      Assert.areEqual(1, invoiceDoc.lines.size(), 'One line');
      Assert.areEqual(2360, invoiceDoc.invoice.Total__c, 'Total with tax');
      Assert.isTrue(
        invoiceDoc.branchAddress.contains('Bengaluru'),
        invoiceDoc.branchAddress
      );
      Assert.isTrue(
        invoiceDoc.branchContact.contains('+91'),
        invoiceDoc.branchContact
      );
      Assert.isNotNull(invoiceDoc.institutionName, 'Institution');

      Test.setCurrentPage(Page.KEM_Receipt_Pdf);
      ApexPages.currentPage().getParameters().put('id', paymentId);
      KemDocumentController receiptDoc = new KemDocumentController();
      Assert.areEqual(500, receiptDoc.allocations[0].Amount__c, 'Allocation');
      Assert.isNotNull(receiptDoc.payment.Receipt_Number__c, 'Receipt number');

      Test.setCurrentPage(Page.KEM_Offer_Letter);
      ApexPages.currentPage().getParameters().put('id', application.Id);
      KemDocumentController letter = new KemDocumentController();
      Assert.areEqual(1, letter.fees.size(), 'Indicative fee');
      Assert.areEqual(2360, letter.feeTotal, 'Indicative total');
      Assert.areEqual(f.branch.Name, letter.branchName, 'Branch');
    }
  }

  @IsTest
  static void rejectsUnsupportedRecords() {
    System.runAs(TestDataFactory.admin()) {
      Branch__c branch = TestDataFactory.createBranch();
      try {
        DocumentController.generateDocument(branch.Id);
        Assert.fail('No documents for branches');
      } catch (AuraHandledException e) {
        Assert.isTrue(e.getMessage().contains('not available'), e.getMessage());
      }
      try {
        DocumentController.getDocuments(
          TestUtil.fakeId(Student_Invoice__c.SObjectType)
        );
        Assert.fail('Unknown record');
      } catch (AuraHandledException e) {
        Assert.isTrue(
          e.getMessage().contains('not accessible'),
          e.getMessage()
        );
      }
    }
  }
}
